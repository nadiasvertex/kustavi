<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kustavi Windows installer (WiX v5).

  Built by "tools/package.py (installer flag)", which stages the full
  application tree into the dist Kustavi folder and then invokes "wix build"
  with: arch x64, define Version=X.Y.Z, define Store=0|1, bindpath
  Stage=<dist Kustavi folder>, bindpath Resources=<the resources folder> (the
  app_icon.ico), out dist/Kustavi-X.Y.Z-x64[-store].msi

  Two flavours come from this one source:
    Store=0  normal installer with the WixUI_InstallDir wizard (needs
             "-ext WixToolset.UI.wixext").
    Store=1  Microsoft Store installer: no UI at all, it just installs.

  Version comes from the repo-root VERSION file (see tools/version.py). The
  whole staged payload is harvested automatically via the Files element and
  the Stage bindpath. Per-user install: no elevation prompt. See
  tools/installer/README.md.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Kustavi"
      Manufacturer="Kustavi"
      Version="$(Version)"
      UpgradeCode="7E9C2A14-3B6D-4F51-9A2E-1C8D5B0F4A73"
      Scope="perUser"
      Compressed="yes">

    <!-- Clean in-place upgrades: an older version is removed before the new
         one is laid down; a downgrade is blocked with a friendly message. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Kustavi is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <?if $(Store) = 1?>
    <!-- Microsoft Store flavour: no wizard, no questions. It installs straight
         to the default per-user location. -->
    <?else?>
    <!-- Standard flavour: welcome page, install-folder choice, progress and a
         finish page. The licence page is skipped (the app ships no licence
         text to show). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
    </UI>
    <?endif?>

    <!-- Add/Remove Programs metadata. The ARP entry and the Start Menu shortcut
         use the app icon (resources/app_icon.ico, generated from
         resources/icon.png), supplied via the Resources
         bindpath. Icon/@Id keeps a real ".ico" extension so Windows Installer
         stores it as an icon rather than falling back to its generic default
         (which is what happened when this pointed at Kustavi.exe with an
         extension-less Id). -->
    <Icon Id="Kustavi.ico" SourceFile="!(bindpath.Resources)\app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="Kustavi.ico" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Per-user install root: %LOCALAPPDATA%\Programs\Kustavi -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Kustavi" />
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut (per-user). -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="KustaviStartMenu"
                  Name="Kustavi"
                  Description="Keep the best of a folder of photos"
                  Target="[INSTALLFOLDER]Kustavi.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="Kustavi.ico" />
        <RegistryValue Root="HKCU" Key="Software\Kustavi\Kustavi"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- The application payload: every file staged under dist/Kustavi/. -->
    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Stage)\**" />
    </ComponentGroup>

    <Feature Id="Main" Title="Kustavi" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
