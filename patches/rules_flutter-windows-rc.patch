+def _compile_win32_resources(ctx, rc_files, rc_data):
+    """Compile flutter create `windows/runner/*.rc` scripts into `.res` blobs.
+
+    The stock flutter create runner declares its app icon and VERSIONINFO in
+    `Runner.rc`; CMake compiles that with `rc.exe` and links the result into
+    the executable. rules_flutter's cc_common path only handles `.cc`/`.cpp`,
+    so without this the shipped `.exe` carries no icon or version metadata.
+
+    `rc.exe` comes from the Windows SDK; Bazel's MSVC toolchain puts its
+    directory on the compile action's `PATH` (and the SDK headers on
+    `INCLUDE`, which `Runner.rc`'s `#include "winres.h"` needs), so we borrow
+    that environment rather than probing the host.
+    """
+    if not rc_files:
+        return []
+
+    cc_toolchain = ctx.attr._cc_toolchain[cc_common.CcToolchainInfo]
+    feature_configuration = cc_common.configure_features(
+        ctx = ctx,
+        cc_toolchain = cc_toolchain,
+    )
+    env = dict(cc_common.get_environment_variables(
+        feature_configuration = feature_configuration,
+        action_name = CPP_COMPILE_ACTION_NAME,
+        variables = cc_common.create_compile_variables(
+            feature_configuration = feature_configuration,
+            cc_toolchain = cc_toolchain,
+        ),
+    ))
+
+    # Keep the msys2 shell from rewriting the `-` option flags or the
+    # `;`-separated INCLUDE list before `rc.exe` sees them.
+    env["MSYS_NO_PATHCONV"] = "1"
+    env["MSYS2_ARG_CONV_EXCL"] = "*"
+
+    res_files = []
+    for rc in rc_files:
+        res = ctx.actions.declare_file("%s_%s.res" % (ctx.label.name, rc.basename[:-len(".rc")]))
+        ctx.actions.run_shell(
+            inputs = depset(direct = [rc] + rc_data),
+            outputs = [res],
+            command = 'rc.exe -nologo -i "%s" -fo "%s" "%s"' % (rc.dirname, res.path, rc.path),
+            env = env,
+            mnemonic = "FlutterWindowsRC",
+            progress_message = "Compiling Windows resources %s" % rc.short_path,
+        )
+        res_files.append(res)
+    return res_files
+
