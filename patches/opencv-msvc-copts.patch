     """
+
+    # MSVC's cl.exe rejects Clang/GCC "-W" warning spellings: "-Wno-foo" collides
+    # with cl's "/W" option and aborts with error D8021. Several upstream module
+    # definitions hardcode such flags (e.g. -Wno-deprecated-volatile), so strip
+    # anything starting with "-W" when building with the Windows toolchain.
+    copts = select({
+        "@platforms//os:windows": [copt for copt in copts if not copt.startswith("-W")],
+        "//conditions:default": copts,
+    })
