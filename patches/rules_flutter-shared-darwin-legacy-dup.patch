+def _detect_apple_sibling_target_dirs(ctx, primary_dir, platform):
+    """Sibling SwiftPM target dirs for a multi-target Apple plugin package.
+
+    Modern federated plugins (e.g. video_player_avfoundation 2.9.5+) split
+    their Package.swift into a Swift target plus ObjC target(s): a shared
+    `<pkg>_objc` target most classes live in, and a per-platform
+    `<pkg>_<platform>` target for the handful of APIs that differ between
+    iOS and macOS (Package.swift makes the shared objc target depend on the
+    platform one conditionally, e.g. `.target(name: "video_player_avfoundation_objc",
+    dependencies: [.target(name: "..._macos", condition: .when(platforms: [.macOS]))])`).
+    Swift code resolves the shared target via `import <pkg>_objc`, which
+    `flutter_apple_plugin_library` already produces automatically from any
+    `.m`/`.mm` sources in its srcs — so it's enough to fold both sibling
+    directories' sources into the same srcs list as the primary target,
+    rather than modeling Package.swift's target graph.
+
+    Args:
+        ctx: The repository_rule context.
+        primary_dir: The main SwiftPM target dir already found (e.g.
+            `darwin/video_player_avfoundation/Sources/video_player_avfoundation`).
+        platform: `"macos"` or `"ios"`.
+
+    Returns:
+        The sibling directories (relative to the package root) that exist
+        and contain Apple sources. Empty when the package isn't split this
+        way.
+    """
+    dirs = []
+    objc_dir = "%s_objc" % primary_dir
+    if _has_files_under(ctx, objc_dir, _APPLE_SRC_EXTENSIONS):
+        dirs.append(objc_dir)
+    platform_dir = "%s_%s" % (primary_dir, platform)
+    if _has_files_under(ctx, platform_dir, _APPLE_SRC_EXTENSIONS):
+        dirs.append(platform_dir)
+    return dirs
+
