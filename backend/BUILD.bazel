load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "server",
    srcs = glob([
        "src/**/*.cpp",
        "include/**/*.h",
    ]),
    includes = ["include"],
    deps = [
        "//proto:service_cc_grpc",
        "@curl//:curl",
        "@grpc//:grpc++",
        "@llama_cpp",
        "@opencv//:core",
        "@opencv//:imgproc",
        "@opencv//:imgcodecs",
        "@opencv//:objdetect",
        "@sqlite3",
        "@stdexec",
        "@cli11",
        "@spdlog",
    ],
    visibility = ["//visibility:public"],
)

# Smoke test: confirm llama.cpp links and reports an accelerated compute
# backend (Metal on macOS, optimized CPU elsewhere). Run via `just test-llama`.
cc_binary(
    name = "llama_smoke",
    srcs = ["test/llama_smoke.cpp"],
    deps = ["@llama_cpp"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "smoke_client",
    srcs = ["test/smoke_client.cpp"],
    # The smoke client spawns the server as a child process; make it
    # available in the runfiles tree.
    data = [":server"],
    deps = [
        "//proto:service_cc_grpc",
        "@grpc//:grpc++",
    ],
    visibility = ["//visibility:public"],
)
