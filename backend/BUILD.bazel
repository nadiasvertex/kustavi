load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "server",
    srcs = glob([
        "src/**/*.cpp",
        "include/**/*.h",
    ]),
    data = [
        "//backend/data:cities",
        "//backend/data:keeper_models",
    ],
    includes = ["include"],
    deps = [
        "//proto:service_cc_grpc",
        "@curl//:curl",
        "@grpc//:grpc++",
        "@llama_cpp",
        "@opencv//:core",
        "@opencv//:imgproc",
        "@opencv//:imgcodecs",
        "@opencv//:objdetect",
        "@opencv//:dnn",
        "@sqlite3",
        "@stdexec",
        "@cli11",
        "@spdlog",
    ],
    visibility = ["//visibility:public"],
)

# Smoke test: confirm llama.cpp links and reports an accelerated compute
# backend (Metal on macOS, optimized CPU elsewhere). Run via `just test-llama`.
cc_binary(
    name = "llama_smoke",
    srcs = ["test/llama_smoke.cpp"],
    deps = ["@llama_cpp"],
    visibility = ["//visibility:public"],
)

# Assertions for the trips clustering + reverse-geocoding. Run via
# `just test-backend` (it also sets KUSTAVI_GEO_DATA so the geo checks run).
cc_binary(
    name = "trips_test",
    srcs = [
        "src/geo/place_index.cpp",
        "src/pass/trips.cpp",
        "test/trips_test.cpp",
    ] + glob([
        "include/geo/*.h",
        "include/pass/trips.h",
    ]),
    data = ["//backend/data:cities"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "keeper_signals_test",
    srcs = [
        "src/pass/keeper_signals.cpp",
        "test/keeper_signals_test.cpp",
    ] + glob([
        "include/pass/keeper_signals.h",
        "include/paths.h",
    ]),
    data = ["//backend/data:keeper_models"],
    includes = ["include"],
    deps = [
        "@opencv//:core",
        "@opencv//:imgproc",
        "@opencv//:imgcodecs",
        "@opencv//:objdetect",
        "@opencv//:dnn",
        "@spdlog",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "smoke_client",
    srcs = ["test/smoke_client.cpp"],
    # The smoke client spawns the server as a child process; make it
    # available in the runfiles tree.
    data = [":server"],
    deps = [
        "//proto:service_cc_grpc",
        "@grpc//:grpc++",
    ],
    visibility = ["//visibility:public"],
)
