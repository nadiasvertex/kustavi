load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "server",
    srcs = glob([
        "src/**/*.cpp",
        "include/**/*.h",
    ]),
    data = [
        "//backend/data:cities",
        "//backend/data:keeper_models",
    ],
    includes = ["include"],
    deps = [
        "//proto:service_cc_grpc",
        "@curl//:curl",
        "@grpc//:grpc++",
        "@llama_cpp",
        "@opencv//:core",
        "@opencv//:imgproc",
        "@opencv//:imgcodecs",
        "@opencv//:objdetect",
        "@opencv//:dnn",
        "@opencv//:videoio",
        "@sqlite3",
        "@stdexec",
        "@cli11",
        "@spdlog",
    ],
    visibility = ["//visibility:public"],
)

# Smoke test: confirm llama.cpp links and reports an accelerated compute
# backend (Metal on macOS, optimized CPU elsewhere). Run via `just test-llama`.
cc_binary(
    name = "llama_smoke",
    srcs = ["test/llama_smoke.cpp"],
    deps = ["@llama_cpp"],
    visibility = ["//visibility:public"],
)

# Assertions for the trips clustering + reverse-geocoding. Run via
# `just test-backend` (it also sets KUSTAVI_GEO_DATA so the geo checks run).
cc_binary(
    name = "trips_test",
    srcs = [
        "src/geo/place_index.cpp",
        "src/pass/trips.cpp",
        "test/trips_test.cpp",
    ] + glob([
        "include/geo/*.h",
        "include/pass/trips.h",
    ]),
    data = ["//backend/data:cities"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "keeper_signals_test",
    srcs = [
        "src/pass/keeper_signals.cpp",
        "test/keeper_signals_test.cpp",
    ] + glob([
        "include/pass/keeper_signals.h",
        "include/paths.h",
    ]),
    data = ["//backend/data:keeper_models"],
    includes = ["include"],
    deps = [
        "@opencv//:core",
        "@opencv//:imgproc",
        "@opencv//:imgcodecs",
        "@opencv//:objdetect",
        "@opencv//:dnn",
        "@spdlog",
    ],
    visibility = ["//visibility:public"],
)

# Assertions for the video pass's blur/motion/duration heuristics. Run via
# `just test-video` (fixtures are small, synthetic, and cheap; the vision
# junk-classifier reuse is not exercised here — see junk_pass's classifier
# tests for that path).
cc_binary(
    name = "video_test",
    srcs = [
        "src/pass/junk.cpp",
        "src/pass/quality.cpp",
        "src/pass/similar.cpp",
        "src/pass/video.cpp",
        "test/video_test.cpp",
    ] + glob([
        "include/collection/*.h",
        "include/pass/junk.h",
        "include/pass/quality.h",
        "include/pass/similar.h",
        "include/pass/video.h",
        "include/image_features.h",
        "include/exec/*.h",
    ]),
    includes = ["include"],
    deps = [
        "@llama_cpp",
        "@opencv//:core",
        "@opencv//:imgcodecs",
        "@opencv//:imgproc",
        "@opencv//:videoio",
        "@spdlog",
        "@stdexec",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "smoke_client",
    srcs = ["test/smoke_client.cpp"],
    # POSIX-only: uses posix_spawn, pipe/poll, waitpid, kill and (on macOS)
    # _NSGetExecutablePath to run the server as a child and drive it. Not ported
    # to Win32 process/pipe APIs, so it is excluded from Windows builds. The
    # `just test-*` recipes that use it are POSIX shell anyway.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    # The smoke client spawns the server as a child process; make it
    # available in the runfiles tree.
    data = [":server"],
    deps = [
        "//proto:service_cc_grpc",
        "@grpc//:grpc++",
    ],
    visibility = ["//visibility:public"],
)
