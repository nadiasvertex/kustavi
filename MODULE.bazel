module(
    name = "kustavi",
    version = "1.1.0",
)

# Tooling support rules
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "hedron_compile_commands", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "868c433f823d2d4eb7ce68198cd9d38bf75d61ae",
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
)

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Core Bazel utility rules
bazel_dep(name = "apple_support", version = "2.8.0")
# For //third_party:mdk_sdk_apple.BUILD.bazel's apple_dynamic_framework_import
# (pulled in transitively by rules_flutter already; declared directly here so
# @rules_apple is visible to our own root-module BUILD/.bzl files).
bazel_dep(name = "rules_apple", version = "4.5.3")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_proto_grpc", version = "5.8.0")
bazel_dep(name = "rules_proto_grpc_cpp", version = "5.8.0")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "grpc", version = "1.83.0")
bazel_dep(name = "cli11", version = "2.6.2")
bazel_dep(name = "spdlog", version = "1.17.0")
bazel_dep(name = "sqlite3", version = "3.53.3")

# HTTPS client for the vision-model download in EnsureModel. TLS backend is
# pinned to boringssl (already pulled by gRPC) via .bazelrc so Linux gets HTTPS
# without an OpenSSL dependency.
bazel_dep(name = "curl", version = "8.21.0.bcr.1")

bazel_dep(name = "opencv", version = "5.0.0.bcr.3")
single_version_override(
    module_name = "opencv",
    patches = [
        "//patches:opencv-wstring-convert.patch",
        "//patches:opencv-msvc-copts.patch",
        "//patches:opencv-msvc-pthread.patch",
    ],
    version = "5.0.0.bcr.3",
)

# libtiff (pulled in transitively by opencv's imgcodecs). Upstream ships a file
# literally named VERSION at the repo root. Bazel's MSVC toolchain puts every
# dependency's repo root on the angle-include search path, and on a
# case-insensitive filesystem `#include <version>` (pulled by <ranges>,
# <format>, …) then resolves to that file instead of the STL header. Delete it;
# the Bazel build derives the version from explicit defines, not this file.
bazel_dep(name = "libtiff", version = "4.7.1")
single_version_override(
    module_name = "libtiff",
    patch_strip = 1,
    patches = ["//patches:libtiff-drop-root-version-file.patch"],
    version = "4.7.1",
)

# Repo-only third party libraries

git_repository(
    name = "stdexec",
    remote = "https://github.com/NVIDIA/stdexec.git",
    commit = "e92245d53dfc37f9bc2a7ef0cc44d570bb7b3386",
    build_file = "//third_party:stdexec.BUILD.bazel",
)

# llama.cpp — local LLM inference engine for the vision (junk) pass.
# Built from source via rules_foreign_cc so llama.cpp's own CMake selects the
# optimal compute backend per OS (Metal on macOS, optimized CPU elsewhere;
# Vulkan/CUDA are opt-in via --define=llama_gpu=...). See
# third_party/llama_cpp.BUILD.bazel.
http_archive(
    name = "llama_cpp",
    build_file = "//third_party:llama_cpp.BUILD.bazel",
    sha256 = "07de784d07b346647da6bd8796a42127304c7508dd007a21f63ab74da21a13cf",
    strip_prefix = "llama.cpp-b10733",
    url = "https://github.com/ggml-org/llama.cpp/archive/refs/tags/b10733.tar.gz",
)

# mdk-sdk — libmdk binaries the `fvp` Flutter plugin (video playback) links
# against on macOS/iOS. See plugin_overlays/fvp/0/BUILD.bazel.tpl and
# third_party/mdk_sdk_apple.BUILD.bazel for why this exists outside pub/
# CocoaPods. Upstream's own podspec points at this same "nightly" URL with no
# integrity pin (https://sourceforge.net/projects/mdk-sdk/files/nightly/); we
# pin the sha256 of what that resolved to as of writing for reproducibility —
# bump both together if fvp's required mdk version moves.
http_archive(
    name = "mdk_sdk_apple",
    build_file = "//third_party:mdk_sdk_apple.BUILD.bazel",
    sha256 = "4ef80796508c629d8085e4af9bff7f93b8308fc06eb4207799c046ef0f844a87",
    strip_prefix = "mdk-sdk",
    url = "https://sourceforge.net/projects/mdk-sdk/files/nightly/mdk-sdk-apple.tar.xz",
)

# Flutter support

# rules_flutter is built against this fork version; 0.4.10 has API changes
# (DartInfo.transitive_resources removed) that break its generated pub spokes.
bazel_dep(name = "rules_dart", version = "0.4.9")
bazel_dep(name = "rules_dart_proto", version = "0.4.9")

# Flutter, built with a hermetic pinned SDK (no host Flutter install required).
bazel_dep(name = "rules_flutter", version = "0.0.0")
git_override(
    module_name = "rules_flutter",
    commit = "cfb2921cb2129d0658ba195396ecd3f1c97aa997",
    patches = [
        "//patches:rules_flutter-subdir-app.patch",
        # Compile windows/runner/Runner.rc with rc.exe and link the .res so the
        # app icon + VERSIONINFO land in the shipped kustavi.exe.
        "//patches:rules_flutter-windows-rc.patch",
        # Skip the legacy <platform>/Classes dir when a package (e.g. fvp)
        # declares sharedDarwinSource and also ships that dir for older SDKs
        # — otherwise both copies get compiled, redefining every symbol.
        "//patches:rules_flutter-shared-darwin-legacy-dup.patch",
        # flutter_apple_plugin_library's `deps` param only threaded into the
        # generated Swift target, never the inner objc_library that compiles
        # a plugin's .m/.mm — so a native SDK dep (e.g. fvp's mdk-sdk) never
        # reached the ObjC compile action at all.
        "//patches:rules_flutter-apple-plugin-lib-objc-deps.patch",
        # A plugin's AppleFrameworkImportInfo (e.g. fvp's mdk-sdk) compiles
        # and links fine but never gets embedded in the app bundle: the
        # runner aggregator that merges every plugin's Apple library only
        # forwarded CcInfo/SwiftInfo, and its own `application` attribute
        # (not `deps`) is invisible to rules_apple's framework
        # auto-embedding aspect.
        "//patches:rules_flutter-apple-plugins-framework-import.patch",
    ],
    remote = "https://github.com/aran/rules_flutter.git",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.44.1")
flutter.pub(
    name = "deps",
    lock = "//frontend:pubspec.lock",
)
# Hand-curated BUILD.bazel overrides for pub plugins whose native side
# rules_flutter's generic pub-package generator can't fully express (e.g.
# fvp's mdk-sdk CocoaPod dependency). See plugin_overlays/.
flutter.plugin_overlays(
    roots = ["//plugin_overlays:BUILD.bazel"],
)
use_repo(
    flutter,
    "deps",
    "flutter_dev_root",
    "flutter_macos_engine",
    "flutter_toolchains",
)

register_toolchains("@flutter_toolchains//:all")
