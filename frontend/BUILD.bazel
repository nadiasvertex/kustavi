load("@rules_flutter//flutter:defs.bzl", "flutter_application")
load("@rules_flutter//flutter:linux.bzl", "flutter_linux_app")
load("@rules_flutter//flutter:macos.bzl", "flutter_macos_app")
load("@rules_flutter//flutter:windows.bzl", "flutter_windows_app")

exports_files(["pubspec.lock"])

flutter_application(
    name = "kustavi_app",
    package_name = "kustavi",  # must match pubspec.yaml name:
    main = "lib/main.dart",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "@deps//:cupertino_icons",
        "@deps//:file_picker",
        "@deps//:fixnum",
        "@deps//:flutter",
        "@deps//:flutter_riverpod",
        "@deps//:fvp",
        "@deps//:grpc",
        "@deps//:path",
        "@deps//:protobuf",
        "@deps//:riverpod_annotation",
        "@deps//:video_player",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_macos_app(
    name = "kustavi_macos",
    application = ":kustavi_app",
    app_name = "Kustavi",
    # Compiled by actool into the bundle's Assets.car and wired into
    # Info.plist as CFBundleIconName. Regenerate with `dart run
    # flutter_launcher_icons` after changing resources/icon.png.
    app_icons = glob(["macos/Runner/Assets.xcassets/AppIcon.appiconset/**"]),
    # `package:fvp` dlopens its FFI half by path — `fvp.framework/fvp` — so
    # that framework has to sit in the bundle alongside `mdk.framework`
    # instead of being statically linked into the runner like the rest of the
    # plugin. Built by plugin_overlays/fvp/0/BUILD.bazel.tpl, which explains
    # the split. The label is fully qualified because only the `deps` hub is
    # in our repo mapping, not the per-package spokes.
    additional_contents = {
        "@@rules_flutter++flutter+deps__fvp//:fvp_framework": "Frameworks",
    },
    bundle_id = "dev.kustavi.app",
    target_compatible_with = ["@platforms//os:macos"],
)

flutter_linux_app(
    name = "kustavi_linux",
    application = ":kustavi_app",
    gtk_app_id = "com.kustavi.desktop",
    # On non-Linux hosts: -c dbg --platforms=@rules_flutter//flutter/platforms:linux_x64
    target_compatible_with = ["@platforms//os:linux"],
)

flutter_windows_app(
    name = "kustavi_windows",
    application = ":kustavi_app",
    target_compatible_with = ["@platforms//os:windows"],
)

# Host router: builds the bundle for whatever desktop OS Bazel is running on.
alias(
    name = "kustavi",
    actual = select({
        "@platforms//os:macos": ":kustavi_macos",
        "@platforms//os:linux": ":kustavi_linux",
        "@platforms//os:windows": ":kustavi_windows",
    }),
)
