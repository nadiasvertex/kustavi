common --enable_bzlmod

# Auto-apply the build:linux / build:macos / build:windows configs below based
# on the host OS. Lets us keep the Clang/GCC warning flags off MSVC.
common --enable_platform_specific_config

# Bazel 9 removed `cc_import` (and friends) from the BUILD-file global namespace.
# rules_foreign_cc 0.15.1 still emits a bare `cc_import()` in its generated
# Windows gettext_runtime BUILD file, so re-enable autoloading it from rules_cc.
common --incompatible_autoload_externally=+cc_import

# rules_flutter pulls rules_jvm_external, which needs a newer toolchain JDK
common --tool_java_language_version=25
common --tool_java_runtime_version=remotejdk_25
startup:windows --windows_enable_symlinks

# Keep the output tree short. The default output_user_root
# (…/_bazel_<user>/<hash>) plus deeply nested generated paths (envoy_api's xDS
# proto packages, for one) blow past Windows' 260-char MAX_PATH inside cl.exe,
# which is not long-path aware even with LongPathsEnabled set. A short root
# buys back ~30 characters.
startup:windows --output_user_root=D:/b/_bzl

# Disable strict header checking to fix external gRPC compilation on macOS
build --features=-layering_check
build --features=-parse_headers

# Flutter plugins commonly `@import FlutterMacOS;`/`@import Flutter;` (the
# template rules_flutter's own plugin generator ships). Without this,
# --incompatible_objc_framework_cleanup drops the imported framework's
# module map from ObjC compile actions, so `@import` (as opposed to
# `#import <FlutterMacOS/FlutterMacOS.h>`) can't resolve inside the sandbox.
build --define=apple.incompatible.objc_framework_propagate_modulemap=true

# libcurl TLS backend: reuse the boringssl gRPC already vendors instead of a
# separate OpenSSL. Gives HTTPS on Linux/Windows; macOS would default to
# SecureTransport but this keeps every platform on one code path.
build --@curl//:ssl_lib=boringssl

# --- Clang/GCC toolchains (Linux, macOS) -------------------------------------
# These flag spellings are rejected by MSVC cl.exe, so they are scoped to the
# platforms that actually use Clang/GCC. See the build:windows block below.

# Ignore several warnings from packages we depend on
build:linux --per_file_copt=external/.*@-Wno-nullability-extension,-Wno-gcc-compat,-Wno-deprecated-declarations,-Wno-unused-function
build:macos --per_file_copt=external/.*@-Wno-nullability-extension,-Wno-gcc-compat,-Wno-deprecated-declarations,-Wno-unused-function

# Allow OpenCV to compile
build:linux --per_file_copt=external/.*@-Wno-error=ambiguous-reversed-operator
build:linux --per_file_copt=external/.*@-Wno-error=enum-compare
build:macos --per_file_copt=external/.*@-Wno-error=ambiguous-reversed-operator
build:macos --per_file_copt=external/.*@-Wno-error=enum-compare

# Apply the CoreGraphics bitwise flag ONLY to external files
build:linux --per_file_copt=external/.*@-Wno-error=enum-enum-conversion
build:macos --per_file_copt=external/.*@-Wno-error=enum-enum-conversion

# Use C++26 standard
build:linux --cxxopt=-std=c++26
build:linux --host_cxxopt=-std=c++26
build:macos --cxxopt=-std=c++26
build:macos --host_cxxopt=-std=c++26

# --- MSVC toolchain (Windows) ----------------------------------------------
# cl.exe needs its own spellings; it does not require the -Wno-* suppressions
# that Clang/GCC do for the external packages.
build:windows --cxxopt=/std:c++latest
build:windows --host_cxxopt=/std:c++latest

# grpc's filter-fusion templates (fused_filters.cc) do not compile with this
# MSVC preview toolchain: promise_based_filter.h instantiates
# RaceAsyncCompletion::Run / MapResult with a void Promise and cl rejects it
# (C2672, "'void' cannot be used as a function parameter"). Filter fusion is a
# perf-only optimization gated at runtime by the fuse_filters experiment;
# GRPC_NO_FILTER_FUSION compiles the file to an empty RegisterFusedFilters().
# The macro appears in no header, so scoping it to this one TU is ODR-safe.
build:windows --per_file_copt=external/grpc.*/fused_filters\.cc$@-DGRPC_NO_FILTER_FUSION

# Treat sources as UTF-8 and emit UTF-8 execution strings. {fmt} static-asserts
# on this (base.h: "Unicode support requires compiling with /utf-8").
build:windows --copt=/utf-8
build:windows --host_copt=/utf-8

# Make cl.exe report a conforming __cplusplus value. Without this MSVC always
# reports 199711L, so libraries that feature-test the standard version (stdexec's
# "requires C++20" #error, among others) fail even under /std:c++latest.
build:windows --cxxopt=/Zc:__cplusplus
build:windows --host_cxxopt=/Zc:__cplusplus

# stdexec also requires MSVC's conforming (C99) preprocessor.
build:windows --cxxopt=/Zc:preprocessor
build:windows --host_cxxopt=/Zc:preprocessor

# Don't enforce strict header-inclusion deps from cl.exe's /showIncludes output.
# Some third-party BCR modules (grpc's channelz/v2tov1 target, for one) have
# imprecise dep declarations for their generated upb headers that only Clang's
# dotd pruning lets slide; matches the -layering_check / -parse_headers relaxations
# already applied above.
build:windows --features=-parse_showincludes

# Route external-repo header dirs through cl's /external:I instead of /I. Bazel's
# MSVC toolchain otherwise lowers -iquote to /I, so every external repo root
# joins the angle-include search — and libtiff ships a root file literally named
# VERSION that then shadows the STL's <version> header (case-insensitive FS),
# wrecking <ranges>/<format>/<filesystem>.
build:windows --features=external_include_paths

# rules_foreign_cc's default pkg-config toolchain builds pkg-config from source,
# which fails on MSVC because the bundled glib expects a `msvc_recommended_pragmas.h`
# that recent glib no longer ships. llama.cpp's CMake build never calls pkg-config,
# so use the preinstalled (PATH) toolchain instead of the from-source one here.
build:windows --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_pkgconfig_toolchain

# Optimize for local development (faster builds)
build:debug --compilation_mode=dbg
build:debug --cxxopt=-O0
build:debug --cxxopt=-g

# Release configuration
build:release --compilation_mode=opt
build:release --cxxopt=-O3
build:release --cxxopt=-DNDEBUG

# macos optimizations
build:release-macos --copt=-march=armv8-a+simd+crypto
build:release-macos --copt=-mcpu=apple-m1
build:release-macos --copt=-ffast-math
build:release-macos --copt=-fvectorize
build:release-macos --copt=-funroll-loops
build:release-macos --linkopt=-Wl,-dead_strip
build:release-macos --features=thin_lto
