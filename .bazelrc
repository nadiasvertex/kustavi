common --enable_bzlmod

# rules_flutter pulls rules_jvm_external, which needs a newer toolchain JDK
common --tool_java_language_version=25
common --tool_java_runtime_version=remotejdk_25
startup:windows --windows_enable_symlinks

# Disable strict header checking to fix external gRPC compilation on macOS
build --features=-layering_check
build --features=-parse_headers

# libcurl TLS backend: reuse the boringssl gRPC already vendors instead of a
# separate OpenSSL. Gives HTTPS on Linux/Windows; macOS would default to
# SecureTransport but this keeps every platform on one code path.
build --@curl//:ssl_lib=boringssl

# Ignore several warnings from packages we depend on
build --per_file_copt=external/.*@-Wno-nullability-extension,-Wno-gcc-compat,-Wno-deprecated-declarations,-Wno-unused-function

# Allow OpenCV to compile
build --per_file_copt=external/.*@-Wno-error=ambiguous-reversed-operator
build --per_file_copt=external/.*@-Wno-error=enum-compare

# Apply the CoreGraphics bitwise flag ONLY to external files
build --per_file_copt=external/.*@-Wno-error=enum-enum-conversion

# Use C++26 standard
build --cxxopt=-std=c++26
build --host_cxxopt=-std=c++26

# Optimize for local development (faster builds)
build:debug --compilation_mode=dbg
build:debug --cxxopt=-O0
build:debug --cxxopt=-g

# Release configuration
build:release --compilation_mode=opt
build:release --cxxopt=-O3
build:release --cxxopt=-DNDEBUG

# macos optimizations
build:release-macos --copt=-march=armv8-a+simd+crypto
build:release-macos --copt=-mcpu=apple-m1
build:release-macos --copt=-ffast-math
build:release-macos --copt=-fvectorize
build:release-macos --copt=-funroll-loops
build:release-macos --linkopt=-Wl,-dead_strip
build:release-macos --features=thin_lto
